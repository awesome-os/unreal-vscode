{
  "name": "unreal-ghost",
  "displayName": "Unreal Ghost — Zero-VS UE5 & B8G_ARENA_V1 Viewport",
  "description": "MIT Unreal Engine 5 extension for Awesome-OS Code - OSS & Eclipse Theia — zero-Visual-Studio UBT builds via b8g-ghost cas-v1 (.NET 11 + ghost-llvm + ghost-winsdk) + B8G_ARENA_V1 libunreal viewport bridge",
  "version": "0.2.0",
  "publisher": "awesome-os",
  "license": "MIT",
  "type": "module",
  "main": "./src/extension.mts",
  "repository": {
    "type": "git",
    "url": "https://github.com/awesome-os/unreal-vscode.git"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22.18.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "unreal",
    "ue5",
    "ubt",
    "clang",
    "llvm",
    "awesome-os",
    "theia",
    "code-oss",
    "b8g-ghost"
  ],
  "activationEvents": [
    "workspaceContains:**/*.uproject",
    "onCommand:unrealGhost.hydrateToolchain",
    "onCommand:unrealGhost.buildProject",
    "onCommand:unrealGhost.generateCompileCommands",
    "onCommand:unrealGhost.openViewport"
  ],
  "contributes": {
    "commands": [
      {
        "command": "unrealGhost.hydrateToolchain",
        "title": "Unreal Ghost: Hydrate Zero-VS Toolchain (cas-v1)"
      },
      {
        "command": "unrealGhost.buildProject",
        "title": "Unreal Ghost: Build UE5 Project via UBT"
      },
      {
        "command": "unrealGhost.generateCompileCommands",
        "title": "Unreal Ghost: Generate compile_commands.json (clangd)"
      },
      {
        "command": "unrealGhost.openViewport",
        "title": "Unreal Ghost: Open B8G_ARENA_V1 libunreal Viewport"
      }
    ],
    "taskDefinitions": [
      {
        "type": "unreal-ghost",
        "required": [
          "target"
        ],
        "properties": {
          "project": {
            "type": "string",
            "description": "Path to the .uproject file."
          },
          "target": {
            "type": "string",
            "description": "UnrealBuildTool target name (e.g. MyGameEditor)."
          },
          "configuration": {
            "type": "string",
            "enum": [
              "Debug",
              "DebugGame",
              "Development",
              "Shipping",
              "Test"
            ],
            "default": "Development",
            "description": "UE5 build configuration."
          },
          "platform": {
            "type": "string",
            "enum": [
              "Win64",
              "Linux"
            ],
            "default": "Win64",
            "description": "Target platform for UnrealBuildTool."
          },
          "engineRoot": {
            "type": "string",
            "description": "Path to user-supplied Epic Unreal Engine 5 installation."
          }
        }
      }
    ],
    "configuration": {
      "title": "Unreal Ghost",
      "properties": {
        "unrealGhost.engineRoot": {
          "type": "string",
          "default": "",
          "description": "Local path to your Epic-licensed Unreal Engine 5 root directory."
        },
        "unrealGhost.casIndexUrl": {
          "type": "string",
          "default": "https://raw.githubusercontent.com/awesome-os/b8g-ghost/main/manifests/index.json",
          "description": "b8g-ghost cas-v1 manifest index URL."
        },
        "unrealGhost.cacheDir": {
          "type": "string",
          "default": ".b8g/unreal-ghost",
          "description": "Local directory for hydrated b8g-ghost toolchain artifacts."
        },
        "unrealGhost.viewportPipe": {
          "type": "string",
          "default": "\\\\.\\pipe\\sectium-dev",
          "description": "Local host IPC pipe/socket for B8G_ARENA_V1 libunreal frame transport."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/unreal-vscode.test.mts"
  }
}
